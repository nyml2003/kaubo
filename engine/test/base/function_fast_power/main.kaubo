var fast_power = |base, exponent|{
    var result = 1;
    var current_power = base;

    while exponent > 0 {
        // 如果当前指数是奇数
        if exponent % 2 == 1{
            result = result * current_power
        };
        // 将指数减半
        exponent = exponent / 2;
        // 更新当前幂次
        current_power = current_power * current_power;
    }
    return result;
}


print(fast_power(2, 10));  // 输出 1024
print(fast_power(3, 13));  // 输出 1594323
